-- This table was added in schema version 5
CREATE TABLE IF NOT EXISTS amiibo(
    "key" INTEGER NOT NULL PRIMARY KEY,
    id TEXT,
    amiiboSeries TEXT NOT NULL,
    character TEXT NOT NULL,
    gameSeries TEXT NOT NULL,
    name TEXT NOT NULL,
    au TEXT,
    eu TEXT,
    jp TEXT,
    na TEXT,
    type TEXT NOT NULL,
    cardNumber INTEGER
) AS AmiiboTable;

CREATE TABLE IF NOT EXISTS amiibo_user_preferences(
    "key" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    amiibo_key INTEGER NOT NULL,
    boxed INTEGER NOT NULL DEFAULT 0,
    opened INTEGER NOT NULL DEFAULT 0,
    wishlist BOOLEAN NOT NULL DEFAULT 0,
    FOREIGN KEY(amiibo_key) REFERENCES amiibo("key"),
    UNIQUE (amiibo_key)
) AS AmiiboUserPreferenceTable;

-- This table was added in schema version 8
CREATE TABLE IF NOT EXISTS amiibo_images(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    amiibo_key INTEGER NOT NULL,
    create_at INTEGER NOT NULL,
    file_path VARCHAR(255) NOT NULL,
    FOREIGN KEY (amiibo_key) REFERENCES amiibo("key") ON DELETE CASCADE
) AS AmiiboImageTable;

CREATE TABLE IF NOT EXISTS amiibo_bundle(
    id INTEGER NOT NULL PRIMARY KEY,
    amiibo_key INTEGER NOT NULL,
    name TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (amiibo_key) REFERENCES amiibo("key") ON DELETE CASCADE
) AS AmiiboBundleTable;

CREATE TABLE IF NOT EXISTS amiibo_bundle_user_preferences(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    amiibo_bundle_id INTEGER NOT NULL,
    boxed INTEGER NOT NULL DEFAULT 0,
    opened INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(amiibo_bundle_id) REFERENCES amiibo_bundle(id),
    UNIQUE (amiibo_bundle_id)
) AS AmiiboBundleUserPreferenceTable;

CREATE TABLE IF NOT EXISTS amiibo_bundle_images(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    amiibo_bundle_id INTEGER NOT NULL,
    create_at INTEGER NOT NULL,
    file_path VARCHAR(255) NOT NULL,
    FOREIGN KEY (amiibo_bundle_id) REFERENCES amiibo_bundle(id) ON DELETE CASCADE
) AS AmiiboBundleImageTable;